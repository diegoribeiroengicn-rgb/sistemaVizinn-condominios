# --- Supabase ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only, used to create users/rows during signup. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
# Publishable key (safe for the browser)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
# Secret key, server-only
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Signing secret for the /api/webhook endpoint (Stripe CLI or dashboard)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Price IDs created in the Stripe dashboard (Product catalog), one per plan
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx

# --- Platform admin dashboard (/admin) ---
# Comma-separated e-mails allowed to view /admin (all condominios, MRR,
# manage subscriptions). ADMIN_EMAILS is the authoritative, server-only
# check; NEXT_PUBLIC_ADMIN_EMAILS only controls whether the "Admin" nav
# link is shown and MUST match it.
ADMIN_EMAILS=diegoribeiroengicn@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=diegoribeiroengicn@gmail.com

# --- Notificações automáticas (e-mail + WhatsApp) ---
# Resend (https://resend.com) — plano grátis cobre 3 mil e-mails/mês.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sem domínio verificado no Resend, use o remetente de teste deles:
EMAIL_FROM=onboarding@resend.dev

# Pra onde vai o formulário "Fale Conosco" da landing page. Se não
# definido, cai no primeiro e-mail de ADMIN_EMAILS.
CONTATO_EMAIL=diegoribeiroengicn@gmail.com

# --- Painel admin: saturação/capacidade (opcional) ---
# Limites dos planos gratuitos, usados pra calcular a "barra de calor"
# de cada serviço em /admin. Ajuste quando migrar de plano.
RESEND_LIMITE_MENSAL=3000
WHATSAPP_LIMITE_MENSAL=1000
# O Supabase não expõe uso real do banco sem uma chave extra da API de
# gerenciamento — esse número é só uma estimativa calibrável (quantos
# condomínios você acha seguro ter no plano gratuito do Supabase).
SUPABASE_LIMITE_CONDOMINIOS=4

# WhatsApp Business Platform, direto pela Meta (sem intermediário como o
# Twilio, pra ficar mais barato). Token e ID do número em
# https://developers.facebook.com/apps > seu app > WhatsApp > API Setup.
# É preciso criar e ter aprovados os templates "encomenda_chegou" e
# "chamado_atribuido" no WhatsApp Manager antes de funcionar — ver README.
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# --- Modo de teste (dev/staging apenas) ---
# Permite criar contas pelo formulário de cadastro SEM passar pelo Stripe
# (botão "Pular pagamento"), para validar o produto sem pagar nada.
# NUNCA deixe true em produção com clientes reais.
ALLOW_TEST_SIGNUP=true
NEXT_PUBLIC_TEST_MODE=true
